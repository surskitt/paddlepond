{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Auto merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
      "minimumReleaseAge": "3 days",
    },
    {
      "description": "Auto merge select major container updates",
      "matchDatasources":["docker"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchPackageNames": [
        "ghcr.io/alexta69/metube",
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select minor container updates",
      "matchDatasources":["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "docker.io/cloudflare/cloudflared",
        "ghcr.io/autobrr/autobrr",
        "ghcr.io/esphome/esphome",
        "ghcr.io/home-operations/gatus-sidecar",
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/kiwigrid/k8s-sidecar",
        "ghcr.io/koenkk/zigbee2mqtt",
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select patch container updates",
      "matchDatasources":["docker"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "ghcr.io/autobrr/qui"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select minor helm chart updates",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "ghcr.io/emberstack/helm-charts/reflector",
        "ghcr.io/home-operations/charts/chaski",
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select patch helm chart updates",
      "matchDatasources":["helm"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select minor mise updates",
      "matchManagers":["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "cli/cli", // gh
        "cloudflare/cloudflared",
        "oxfmt",
        "postfinance/topf",
        "zizmorcore/zizmor",
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto merge select patch mise updates",
      "matchManagers":["mise"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    }
  ]
}
