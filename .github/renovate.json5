{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base",
        "docker:enableMajor",
        ":disableRateLimiting",
        ":dependencyDashboard",
        ":semanticCommits",
        ":automergeDigest",
        ":automergeBranch",
        "github>surskitt/paddlepond//.github/renovate/autoMerge.json5",
        "github>surskitt/paddlepond//.github/renovate/groups.json5",
        "github>surskitt/paddlepond//.github/renovate/labels.json5",
        "helpers:pinGitHubActionDigests",
        "github>home-operations/renovate-presets#10.0.1",
        "github>home-operations/renovate-presets//apps/talosFactory.json5#10.0.1",
    ],
    "platform": "github",
    "onboarding": false,
    "requireConfig": "optional",
    "suppressNotifications": [
        "prIgnoreNotification"
    ],
    "rebaseWhen": "conflicted",
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": true
    },
    "packageRules": [
      {
        "description": "Loose versioning for non-semver packages",
        "matchDatasources": [
          "docker",
        ],
        "versioning": "loose",
        "matchPackagePatterns": [
          "changedetection",
          "plex",
          "qbittorrent",
        ],
      },
      {
        "description": "Use custom versioning for Minio",
        "matchDatasources": [
          "docker"
        ],
        "versioning": "regex:^RELEASE\\.(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)T.*Z$",
        "matchPackagePatterns": [
          "minio",
        ],
      }
    ],
    "prBodyDefinitions": {
      "Package name": "{{{packageName}}}",
    },
    "prBodyColumns": [
      "Package",
      "Package name",
      "Update",
      "Type",
      "New value",
      "Package file",
      "References"
    ]
}
