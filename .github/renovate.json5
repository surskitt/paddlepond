{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "docker:enableMajor",
        ":disableRateLimiting",
        ":dependencyDashboard",
        ":semanticCommits",
        "github>surskitt/paddlepond//.github/renovate/autoMerge.json5",
        "github>surskitt/paddlepond//.github/renovate/groups.json5",
        "github>surskitt/paddlepond//.github/renovate/labels.json5",
        "helpers:pinGitHubActionDigests",
        "github>home-operations/renovate-presets#11.0.0",
        "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ],
    "platform": "github",
    "onboarding": false,
    "requireConfig": "optional",
    "suppressNotifications": [
        "prIgnoreNotification"
    ],
    "rebaseWhen": "conflicted",
    "lockFileMaintenance": {
      "enabled": true,
      "automerge": true
    },
    "packageRules": [
      {
        "description": "Loose versioning for non-semver packages",
        "matchDatasources": [
          "docker",
        ],
        "versioning": "loose",
        "matchPackageNames": [
          "/changedetection/",
          "/plex/",
          "/qbittorrent/",
        ],
      },
      {
        "description": "Use custom versioning for Minio",
        "matchDatasources": [
          "docker"
        ],
        "versioning": "regex:^RELEASE\\.(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)T.*Z$",
        "matchPackageNames": [
          "/minio/",
        ],
      },
      {
        "description": "Separate mallard system updates",
        "matchPackageNames": [
          "ghcr.io/coredns/charts/coredns",
          "ghcr.io/siderolabs/kubelet",
          "docker.io/envoyproxy/gateway-helm",
          "siderolabs/talos"
        ],
        "matchFileNames": ["**/mallard/**"],
        "additionalBranchPrefix": "mallard-",
        "commitMessageSuffix": "(mallard)",
      },
      {
        "description": "Separate serpentine system updates",
        "matchPackageNames": [
          "ghcr.io/coredns/charts/coredns",
          "ghcr.io/siderolabs/kubelet",
          "docker.io/envoyproxy/gateway-helm",
          "siderolabs/talos"
        ],
        "matchFileNames": ["**/serpentine/**"],
        "additionalBranchPrefix": "serpentine-",
        "commitMessageSuffix": "(serpentine)",
      },
      {
        "description": "Separate all minor and patch talos updates",
        "matchPackageNames": [
          "siderolabs/talos"
        ],
        "separateMinorPatch": true
      }
    ],
    "prBodyDefinitions": {
      "Package name": "{{{packageName}}}",
    },
    "prBodyColumns": [
      "Package",
      "Package name",
      "Update",
      "Type",
      "New value",
      "Package file",
      "References"
    ]
}
